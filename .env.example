# Copy this to .env for local testing (don't commit .env file)

# Option 1: JSONBin.io
JSONBIN_API_KEY=your_api_key_here
JSONBIN_BIN_ID=your_bin_id_here

# Option 2: GitHub Gist (alternative to JSONBin)
# GITHUB_TOKEN=your_personal_access_token
# GITHUB_GIST_ID=your_gist_id_here

# Your existing environment variable (keep this too)
ARTISTS_DATA=your_base64_encoded_data_here
